{
  "extends": "@risu729/tsconfigs/bundler",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.TypedArrays", "ESNext.Temporal", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
