amends "https://raw.githubusercontent.com/risu729/hk-config/9e91957751c9c374bf5b3dafeff6b71d705a7919/presets.pkl"

import "https://raw.githubusercontent.com/risu729/hk-config/9e91957751c9c374bf5b3dafeff6b71d705a7919/helpers.pkl"

steps = (helpers.pick(new Listing {
  "oxlint"
  "oxfmt"
  "github-actions"
  "tombi"
  "rumdl"
  "yaml"
  "typos"
  "hygiene"
})) {
  ["typos"] {
    // The builtin diff wrapper uses POSIX shell syntax; checks/fixes work on Windows.
    check_diff = null
  }
  ["runtime"] {
    check = "mise run check:runtime"
  }
  ["docs-links"] {
    check = "mise run check:docs"
  }
}
