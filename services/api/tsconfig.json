{
  "extends": "@risu729/tsconfigs/bundler",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.TypedArrays"],
    "types": ["node", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "test", "smoke", "*.config.ts", "worker-runtime.ts", ".cloudflare/types"],
  "exclude": ["test/fixtures"]
}
