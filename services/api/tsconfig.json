{
  "extends": "@risu729/tsconfigs/bundler",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "ES2023.Array",
      "ES2024.Promise",
      "ES2024.Collection",
      "ESNext.TypedArrays",
      "ESNext.Temporal"
    ],
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  "include": ["src", "test", "smoke", "*.config.ts", "worker-runtime.ts", ".cloudflare/types"],
  "exclude": ["test/fixtures"]
}
