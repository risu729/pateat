{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "promise", "react", "jsx-a11y"],
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "max-lines": ["error", { "max": 1000 }]
  },
  "ignorePatterns": [
    "**/.wxt/**",
    "**/.output/**",
    "**/.cloudflare/**",
    "**/.vitepress/cache/**",
    "**/.vitepress/dist/**",
    "**/worker-configuration.d.ts"
  ],
  "overrides": [
    {
      // The owner pages and the contracts they import run in whichever browser opens them.
      "files": ["services/api/web/**", "packages/contracts/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "Temporal",
            "message": "the owner pages run in any browser, which may lack Temporal; use Date here"
          }
        ]
      }
    }
  ]
}
