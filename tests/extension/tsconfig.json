{
  "extends": "@risu729/tsconfigs/bundler",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "ES2024.Promise",
      "ES2024.Collection",
      "ESNext.Collection",
      "ES2025.RegExp",
      "ESNext.TypedArrays",
      "ESNext.Temporal",
      "DOM"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts", "fixtures/*.ts"]
}
