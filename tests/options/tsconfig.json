{
  "extends": "@risu729/tsconfigs/bundler",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "ES2024.Promise",
      "ES2025.Promise",
      "ES2024.Collection",
      "ESNext.Collection",
      "ESNext.Iterator",
      "ES2025.Intl",
      "ESNext.TypedArrays",
      "ESNext.Temporal",
      "DOM"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom", "vite/client", "@vitest/browser-playwright"]
  },
  "include": ["*.ts", "*.tsx"]
}
