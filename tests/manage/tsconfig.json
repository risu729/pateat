{
  "extends": "@risu729/tsconfigs/bundler",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "ES2024.Collection", "ESNext.TypedArrays", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom", "@vitest/browser-playwright"]
  },
  "include": ["*.ts", "*.tsx", "../../services/api/web/env.d.ts"]
}
